{
  "name": "jjq",
  "displayName": "jjq",
  "description": "Quick JJ interface",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "publisher": "wes",
  "contributes": {
    "commands": [
      {
        "command": "jjq.changes",
        "title": "Changes",
        "category": "jjq"
      },
      {
        "command": "jjq.setRepository",
        "title": "Set JJ Repository Location",
        "category": "jjq"
      },
      {
        "command": "jjq.monoTest",
        "title": "mono test",
        "category": "jjq"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "__test": "vscode-test",
    "test": "UPDATE_SNAPSHOT=new yarn mocha --require ts-node/register --require mocha-expect-snapshot src/test/**"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "expect": "^29.7.0",
    "mocha": "^11.1.0",
    "mocha-expect-snapshot": "^7.2.0",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@types/cross-spawn": "^6.0.6",
    "cross-spawn": "^7.0.6"
  }
}
